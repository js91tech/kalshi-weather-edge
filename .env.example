# Copy to .env (never commit real keys)
# Option A — website email/password (works only if Kalshi still allows API password login)
KALSHI_EMAIL=
KALSHI_PASSWORD=

# Option B — official API key auth (recommended)
KALSHI_API_KEY_ID=
# Prefer a file path locally:
KALSHI_PRIVATE_KEY_PATH=
# Or paste PEM (Streamlit Cloud secrets / CI). Use \n for newlines if needed:
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
KALSHI_PRIVATE_KEY_PEM=
# production | demo
KALSHI_ENV=production

# Discord or Slack incoming webhook for scheduled scan alerts
ALERT_WEBHOOK_URL=
